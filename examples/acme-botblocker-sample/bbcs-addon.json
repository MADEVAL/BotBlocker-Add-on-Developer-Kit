{
  "schema": "2.0",
  "slug": "acme-botblocker-sample",
  "name": "ACME BotBlocker Sample Add-on",
  "version": "1.0.0",
  "requires_core": "1.7.5",
  "requires_php": "7.4",
  "author": "ACME Security",
  "description": "Demonstrates a BotBlocker Add-on API v2 package with a polished settings help panel, safe options, lifecycle callbacks, icon, scripts, and a response header.",
  "main": "acme-botblocker-sample.php",
  "core": "inc/core.php",
  "settings": {
    "view": "inc/settings.php",
    "option": "acme_bbcs_sample_settings",
    "sanitize": "acme_bbcs_sample_sanitize_settings"
  },
  "lifecycle": {
    "activate": "acme_bbcs_sample_activate",
    "deactivate": "acme_bbcs_sample_deactivate",
    "delete": "acme_bbcs_sample_delete"
  },
  "features": [
    "sample_response_header"
  ],
  "abilities": [
    {
      "name": "botblocker/get-sample-header",
      "label": "Get sample header",
      "setting_key": "bbcs_ability_get_sample_header",
      "definition": "acme_bbcs_sample_ability_definition",
      "execute": "acme_bbcs_sample_ability_execute",
      "permission": "acme_bbcs_sample_ability_can_read",
      "public": true,
      "pii": false,
      "risk": "read"
    }
  ],
  "assets": {
    "icon": "assets/icon.svg",
    "readme": "readme.txt"
  }
}
